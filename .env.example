SERVER_PORT=9090
# Document parsing adapter: docker compose --profile documents up -d --build docling
DOCLING_URL=http://127.0.0.1:5001
DOCUMENT_MAX_FILE_BYTES=209715200
DOCUMENT_MAX_PAGES=1000
DOCUMENT_MAX_BLOCKS=2000
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=replace-with-strong-db-password
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=replace-with-strong-minio-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-strong-qdrant-key
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
FFMPEG_DIR=
OCR_COMMAND=tesseract
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGES=chi_sim,eng
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document pipeline: parser workers must match the Docling service setting.
DOCUMENT_PARSER_WORKERS=1
DOCUMENT_DISPATCH_WORKERS=4
DOCUMENT_PARSE_BATCH_PAGES=4
DOCUMENT_PARSE_BATCH_TIMEOUT_SECONDS=180
DOCUMENT_PARSER_THREADS=4
DOCUMENT_PARSER_MEMORY=6g
DOCUMENT_PARSER_CPUS=4

DOCUMENT_CHAT_WORKERS=2

DOCUMENT_PDF_PARSER=FAST
# Experimental paragraph/table streaming: DOCX_STREAM. Production default stays DOCLING.
DOCUMENT_DOCX_PARSER=DOCLING
DOCUMENT_DOCX_STREAM_WORKERS=2
DOCUMENT_DOCX_BATCH_NODES=32
DOCUMENT_DOCX_BATCH_CHARS=12000
# Opt-in bounded packing before batch publication; default remains disabled.
DOCUMENT_DOCX_BOUNDARY_AWARE=false
DOCUMENT_DOCX_BOUNDARY_LOOKAHEAD_NODES=8
DOCUMENT_DOCX_STREAM_STRICT=true
DOCUMENT_DOCX_MAX_IMAGE_BYTES=33554432
DOCUMENT_DOCX_MAX_IMAGE_PIXELS=40000000
DOCUMENT_DOCX_OCR_TIMEOUT_SECONDS=30
# Optional comma-separated document IDs forced to Docling; other PDFs keep the default.
DOCUMENT_DOCLING_DOCUMENT_IDS=
DOCUMENT_TABLE_MODE=accurate
DOCUMENT_FAST_PARSER_WORKERS=4

# Adaptive document strategies: local BGE/Milvus, independent of the chat API.
DOCUMENT_RETRIEVAL_URL=http://127.0.0.1:5002
DOCUMENT_INDEX_VERSION=hybrid-v3-section-bge-small-zh-350
DOCUMENT_TITLE_MATCH_BONUS=1.0
DOCUMENT_FOCUS_TITLE_BONUS=1.0
DOCUMENT_SHORT_TOKENS=8000
DOCUMENT_MEDIUM_TOKENS=20000
DOCUMENT_LARGE_TOKENS=50000
DOCUMENT_CONTEXT_TOKENS=32768
DOCUMENT_OUTPUT_TOKENS=2048
# Optional paid query planning: original query is always retained. Preview never calls it.
DOCUMENT_QUERY_REWRITE_ENABLED=false
# Single-route confidence gate; defaults are starting thresholds, not calibrated probabilities.
DOCUMENT_RETRIEVAL_FALLBACK_ON_EMPTY=true
DOCUMENT_RETRIEVAL_FALLBACK_ON_LOW_CONFIDENCE=true
DOCUMENT_RETRIEVAL_BM25_MIN_COVERAGE=0.55
DOCUMENT_RETRIEVAL_DENSE_MIN_SCORE=0.45
DOCUMENT_RETRIEVAL_QUALITY_TOP_K=5
DOCUMENT_SAFETY_TOKENS=1024
DOCUMENT_DENSE_TOP_K=30
DOCUMENT_SPARSE_TOP_K=30
RERANK_MAX_TOKENS=256
# Experimental retrieval router; enable only after quality/latency A/B validation.
DOCUMENT_RETRIEVAL_ROUTING_ENABLED=false
DOCUMENT_RETRIEVAL_RUN_MODE=ROUTED
# SHADOW requires a separate model-serving process with its own resource limits.
DOCUMENT_RETRIEVAL_SHADOW_URL=
DOCUMENT_RETRIEVAL_SHADOW_SAMPLE_RATE=0.01

# Optional bounded preflight for AUTO; explicit FAST/DOCLING remain unchanged.
DOCUMENT_PRESCAN_ENABLED=false
DOCUMENT_PRESCAN_MAX_PAGES=12
DOCUMENT_PRESCAN_BUDGET_MS=2000
# Optional lexical aliases; keep disabled until corpus-specific A/B acceptance.
SYNONYM_EXPANSION_ENABLED=false
SYNONYM_ROUTE_WEIGHT=0.25
SYNONYM_MAX_TERMS=6
# Experimental parent/child index: use a fresh index version / rebuild.
DOCUMENT_HIERARCHY_ENABLED=false
DOCUMENT_PARENT_TARGET_TOKENS=1000
DOCUMENT_PARENT_MAX_TOKENS=1500
DOCUMENT_PARENT_CONTEXT_ENABLED=false
DOCUMENT_PARENT_CONTEXT_MAX_BYTES=6000
DOCUMENT_PARENT_CONTEXT_TOTAL_BYTES=12000
DOCUMENT_FUSION_TOP_K=28
DOCUMENT_LLM_REASONING_EFFORT=none
DOCUMENT_FINAL_TOP_K=12
# Conservative byte bound for retrieved ID/text evidence; full prompt checked separately.
DOCUMENT_MAX_EVIDENCE_BYTES=20000
DOCUMENT_MAX_QUERY_DOCUMENTS=64
DOCUMENT_RRF_K=60
DOCUMENT_MAX_GLOBAL_CALLS=64
DOCUMENT_CHUNK_TARGET_TOKENS=350
DOCUMENT_CHUNK_MAX_TOKENS=480
DOCUMENT_CHUNK_MIN_PREFERRED_TOKENS=80
DOCUMENT_CHUNK_MERGE_PEERS=true
DOCUMENT_FAST_BATCH_PAGES=32
DOCUMENT_CONTINUITY_ENABLED=true



# Production ingestion requires legacy. Experimental strategies are preview/evaluation only.
DOCUMENT_CHUNK_STRATEGY=legacy
